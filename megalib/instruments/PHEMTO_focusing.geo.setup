Name PHEMTO_config1_focusing
Version 1.0

# =====================================================================
#  PHEMTO detector + collimator ONLY (no Laue-lens crystals).
#  Use this for the ring-source focusing runs (make_ring_source.py):
#  the crystals are represented by the beam SOURCES, so the passive
#  crystals must NOT be in the geometry or they would attenuate the
#  already-"diffracted" photons on their way to the detector.
#
#  NOTE: the ring sources start at z = 2000 cm, so the WorldVolume must
#  reach that high (near-field sources outside the world are killed).
#  The SurroundingSphere stays small: it is only used by FAR-field
#  sources, and these ring beams are near-field.
# =====================================================================

####################
#  Model options   #
####################

// Choose Materials.geo to include passive material
// Choose Materials_v.geo to remove passive material
#Include Materials.geo
Include ../detectors/geometry/Materials_v.geo

Include ../detectors/geometry/si.geo
Include ../detectors/geometry/cdte4x4.geo

#Include ACD.det
Include ../detectors/CdTe4x4detector.det
Include ../detectors/Sidetector.det

DefaultRangeCut 0.000002
StoreScientific true 6

// Small sphere: only the detector needs enclosing (ring beams are near-field)
SurroundingSphere 		120.0 0.0 0.0 0.0 120.0
#ShowSurroundingSphere true

// Tall world so the ring sources at z = 2000 cm are inside it
// (half-x/y >= ring radius ~159 cm; half-z >= 2000 cm)
Volume WorldVolume
WorldVolume.Material Vacuum
WorldVolume.Visibility 0
WorldVolume.Shape BRIK 200. 200. 2100.
WorldVolume.Mother 0

####################
#     Triggers     #
####################

// Include trigger information
Trigger CdTetrigger1
CdTetrigger1.Veto false
CdTetrigger1.TriggerByDetector true
CdTetrigger1.Detector CdTecal_U 1

Trigger SItrigger
SItrigger.Veto False
SItrigger.TriggerByDetector true
SItrigger.Detector SiSDDet 1

####################
#  Lead Collimator #
####################
//Volume Collimator
//Collimator.Material Lead
//Collimator.Shape TUBS 7.6 7.73 47.5 0. 360.                // change the thickness here if necessary
//Collimator.Position 0. 0. 52.5 // 5cm above Si
//Collimator.Visibility 1
//Collimator.Color 1
//Collimator.Mother WorldVolume

Volume Collimator
Collimator.Material Lead
Collimator.Shape TUBS 2.5 3.5 8.975 0. 360.   // radius 2.5cm, thickness 1cm, 11.7747 hight, mass = 3.8368 kg             // change the thickness here if necessary
Collimator.Position 0. 0. 14.225 // 5cm above Si
Collimator.Visibility 1
Collimator.Color 1
Collimator.Mother WorldVolume


####################
#  Detector layout #
####################

// ----- Si -----
Si.Mother WorldVolume
Si.Position 0. 0. 0.

// ----- CdTe -----
CdTe4x4.Mother WorldVolume
CdTe4x4.Position 0. 0. -1.625 // Bottom Si <-> Top CdTe = 1.5cm
